{
  "name": "exi-engine",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./dist/exi-engine.js": {
      "types": "./index.d.ts",
      "default": "./dist/exi-engine.js"
    },
    "./dist/exi-engine.global.js": "./dist/exi-engine.global.js",
    "./runtime-agent": "./src/ai/runtime-agent.js",
    "./package.json": "./package.json"
  },
  "types": "index.d.ts",
  "description": "A dependency-free 2D WebGL2/WebGPU game engine with an AI-agent (MCP) bridge.",
  "keywords": [
    "game-engine",
    "2d",
    "webgl2",
    "webgpu",
    "html5",
    "canvas",
    "tilemap",
    "tiled",
    "mcp",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozkantasli/ExiEngine.git"
  },
  "homepage": "https://github.com/ozkantasli/ExiEngine#readme",
  "bugs": {
    "url": "https://github.com/ozkantasli/ExiEngine/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/",
    "!src/demo.js",
    "dist/",
    "index.d.ts",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node server.mjs --port 4173",
    "build": "node tools/build.mjs",
    "test:build": "node test/build-smoke.mjs",
    "prepack": "node tools/build.mjs",
    "doctor": "node test/doctor.mjs",
    "check": "npm test",
    "mcp": "node tools/exi-mcp-server.mjs",
    "test:static": "node test/static-smoke.mjs",
    "test:server": "node test/server-smoke.mjs",
    "test:clients": "node test/client-config-smoke.mjs",
    "test:clients:native": "node test/client-config-smoke.mjs --native",
    "test:mcp": "node test/mcp-smoke.mjs",
    "test:e2e:browser": "node test/e2e/browser-e2e.mjs",
    "test": "node test/run-all.mjs",
    "test:unit": "node test/unit/run-unit.mjs",
    "test:typecheck": "node test/typecheck-syntax.mjs",
    "test:coverage": "node test/coverage/coverage.mjs",
    "lint": "node tools/lint.mjs",
    "bench:regression": "node test/benchmark/benchmark-regression.mjs",
    "verify": "node test/release-gate.mjs",
    "bench": "node test/benchmark/run.mjs"
  }
}
